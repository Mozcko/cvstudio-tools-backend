# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cvstudio

# development | production (production hides /docs)
ENVIRONMENT=development
# true = log every SQL statement
DEBUG=false

# Clerk Authentication
# Frontend API URL of your Clerk instance (Clerk Dashboard -> API Keys). REQUIRED.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Signing secret of the Clerk webhook endpoint pointing at /api/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe Integration
STRIPE_API_KEY=sk_test_...
# Signing secret of the Stripe webhook endpoint pointing at /api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_7D=price_...
STRIPE_PRICE_30D=price_...
STRIPE_PRICE_LIFETIME=price_...

# AI Configuration
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=100
# AI-assisted CV imports a free user gets in total
FREE_IMPORT_LIMIT=2
# Enhance / Optimize runs a free user gets per rolling 7 days
FREE_AI_WEEKLY_LIMIT=3

# Frontend URL (for CORS and success/cancel redirects)
FRONTEND_URL=http://localhost:4321

# Error reporting (optional). Leave empty to disable.
SENTRY_DSN=
